{
  "name": "ifba-a11y",
  "version": "1.0.0",
  "description": "Automated WCAG 2.2 AA accessibility evaluation of the institutional portal of the Instituto Federal de Educação, Ciência e Tecnologia da Bahia, with axe-core and the IBM Equal Access Checker",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "collect": "playwright test"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "equal-access",
    "playwright",
    "reproducible-research"
  ],
  "author": "Rulian de Jesus Cruz",
  "license": "MIT",
  "engines": {
    "node": "24.17.x"
  },
  "overrides": {
    "uuid": "~11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.12.1",
    "@eslint/js": "~10.0.1",
    "@playwright/test": "~1.61.1",
    "@types/node": "~24.13.3",
    "@vitest/coverage-v8": "~4.1.11",
    "@vitest/eslint-plugin": "~1.6.23",
    "accessibility-checker": "~4.0.26",
    "eslint": "~10.15.0",
    "eslint-plugin-playwright": "~2.10.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.74.0",
    "vitest": "~4.1.11"
  }
}
