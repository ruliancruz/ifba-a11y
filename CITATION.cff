    given-names: Rulian de Jesus
    orcid: https://orcid.org/0009-0009-1050-5153
    affiliation: >-
      Instituto Federal de Educação, Ciência e Tecnologia da Bahia
version: 1.0.0
date-released: '2026-09-04'
license: MIT
repository-code: https://github.com/ruliancruz/ifba-a11y
keywords:
  - web accessibility
  - WCAG 2.2
  - automated accessibility testing
  - axe-core
  - IBM Equal Access Checker
  - Playwright
  - reproducible research
  - higher education
  - Instituto Federal de Educação, Ciência e Tecnologia da Bahia
  - IFBA
